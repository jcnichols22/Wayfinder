# ---------------------------------------------------------------------------
# Field Tracker environment configuration
# Copy this file to .env and fill in real values before running docker compose.
# ---------------------------------------------------------------------------

# --- Authentication (single user) ---
# Username used to log in to the app.
AUTH_USERNAME=admin

# Preferred: a bcrypt hash of your password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# (run from apps/api after `npm install`)
AUTH_PASSWORD_HASH=

# Fallback for quick local setup only: plain-text password.
# If AUTH_PASSWORD_HASH is set above, this is ignored. Do NOT use this in production.
AUTH_PASSWORD=changeme

# Secret used to sign login session tokens. Use a long random string in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

# --- Database ---
# Overridden automatically inside Docker (see docker-compose.yml). Used for local dev.
DATABASE_URL="file:./dev.db"

# --- API server ---
PORT=4000
NODE_ENV=production
# Comma-separated list of origins allowed to call the API with credentials.
# For the bundled docker-compose setup (web container proxies /api) you usually
# don't need to change this. If you host the frontend separately, list its origin(s):
CORS_ORIGIN=https://tracker.thelabrack.com

# --- Mileage provider ---
# One of: openrouteservice (default) | google | mapquest
# If no matching API key is set below, mileage falls back to manual entry (0 mi, flagged as estimated).
MILEAGE_PROVIDER=openrouteservice

# Get a free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# https://developers.google.com/maps/documentation/distance-matrix/get-api-key
GOOGLE_MAPS_API_KEY=

# https://developer.mapquest.com/
MAPQUEST_API_KEY=

# --- Cloudflare Tunnel (optional, for public/remote access) ---
# Token for a Cloudflare Tunnel (from Cloudflare Zero Trust → Networks → Tunnels).
# When set, the cloudflared service in docker-compose will expose the app publicly
# behind Cloudflare (and optionally Cloudflare Access) without opening any ports.
CLOUDFLARE_TUNNEL_TOKEN=

# Force the session cookie to be sent only over HTTPS. The API serves secure cookies
# automatically in production (NODE_ENV=production)unless this is explicitly set to "false".
# Set to "false" only if you're running behind a plain-HTTP reverse proxy on a trusted LAN.
FORCE_SECURE_COOKIE=true
